    "@deck.gl/mesh-layers": "^9.4.1",
    "@stylexjs/stylex": "^0.19.2",
    "d3-geo": "^3.1.2",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
