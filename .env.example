# Copy to .env (gitignored). Only needed for the Mistral-powered assistant;
# without it the assistant uses an offline rule-based parser.
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# Spoken replies voice (Voxtral TTS): en_paul (default), gb_oliver, gb_jane
# GROUNDWORK_VOICE=en_paul
# Street View previews on hex click (optional; either one).
# Google: Maps JavaScript API + Street View Static API enabled. GOOGLE_MAPS_BROWSER_KEY is the
# referrer-restricted key the browser viewer uses (falls back to GOOGLE_MAPS_API_KEY).
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BROWSER_KEY=
# Free alternative: a Mapillary client token (mapillary.com/dashboard/developers).
# MAPILLARY_TOKEN=
